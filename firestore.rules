rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function homePath(id) { return /databases/$(database)/documents/households/$(id); }
    function invitePath(id) { return /databases/$(database)/documents/householdInvites/$(id); }
    function ownMembership(id) {
      return getAfter(userPath(request.auth.uid)).data.householdId == id;
    }
    function freshMembership(id) {
      return !exists(userPath(request.auth.uid)) && ownMembership(id);
    }
    function validHome(data) {
      return data.keys().hasOnly(['name','ownerId','memberIds','activeInviteId','createdAt'])
        && data.name is string && data.name == data.name.trim()
        && data.name.size() >= 1 && data.name.size() <= 40
        && data.ownerId is string && data.memberIds is list
        && data.memberIds.size() >= 1 && data.memberIds.size() <= 2
        && data.memberIds.toSet().size() == data.memberIds.size()
        && data.memberIds[0] == data.ownerId
        && (data.activeInviteId == null || (data.activeInviteId is string && data.activeInviteId.matches('^[a-f0-9]{32}$')))
        && data.createdAt is timestamp;
    }
    function usableInvite(data) {
      return data.usedBy == null && data.usedAt == null
        && request.time < data.createdAt + duration.value(24,'h');
    }
    function recipient(data) {
      return data.targetEmail == request.auth.token.email.lower();
    }
    function activeInvite(id,data) {
      let home = get(homePath(data.householdId)).data;
      return home.activeInviteId == id && home.memberIds.size() == 1;
    }
    function consumedWithHome(id,data) {
      let afterHome = getAfter(homePath(data.householdId)).data;
      return afterHome.activeInviteId == null
        && afterHome.memberIds == [data.createdBy,request.auth.uid]
        && freshMembership(data.householdId);
    }
    match /users/{uid} {
      allow get: if verified() && uid == request.auth.uid;
      allow create: if verified() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['householdId','createdAt'])
        && request.resource.data.householdId is string
        && request.resource.data.createdAt == request.time
        && request.auth.uid in getAfter(homePath(request.resource.data.householdId)).data.memberIds;
      allow list, update, delete: if false;
    }
    match /households/{id} {
      allow get: if verified() && request.auth.uid in resource.data.memberIds;
      allow list, delete: if false;
      allow create: if verified() && validHome(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.activeInviteId == null
        && request.resource.data.createdAt == request.time
        && freshMembership(id);
      function managesInvite() {
        let data = request.resource.data;
        return request.auth.uid == resource.data.ownerId
          && resource.data.memberIds.size() == 1
          && data.diff(resource.data).affectedKeys().hasOnly(['activeInviteId'])
          && (data.activeInviteId == null || newInvite(data.activeInviteId));
      }
      function newInvite(code) {
        let invitation = getAfter(invitePath(code)).data;
        return !exists(invitePath(code))
          && invitation.householdId == id
          && invitation.createdBy == request.auth.uid
          && invitation.createdAt == request.time;
      }
      function joins() {
        let before = get(invitePath(resource.data.activeInviteId)).data;
        let after = getAfter(invitePath(resource.data.activeInviteId)).data;
        return resource.data.memberIds.size() == 1
          && !(request.auth.uid in resource.data.memberIds)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds','activeInviteId'])
          && request.resource.data.memberIds == [resource.data.ownerId,request.auth.uid]
          && request.resource.data.activeInviteId == null
          && before.householdId == id && before.createdBy == resource.data.ownerId
          && usableInvite(before) && recipient(before)
          && after.usedBy == request.auth.uid && after.usedAt == request.time
          && freshMembership(id);
      }
      allow update: if verified() && validHome(request.resource.data)
        && (managesInvite() || joins());
    }
    match /householdInvites/{code} {
      allow get: if verified() && (
        (request.auth.uid == resource.data.createdBy
          && request.auth.uid in get(homePath(resource.data.householdId)).data.memberIds)
        || (recipient(resource.data) && usableInvite(resource.data) && activeInvite(code,resource.data))
      );
      allow list, delete: if false;
      allow create: if verified()
        && code.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly(['householdId','householdName','createdBy','targetEmail','createdAt','usedBy','usedAt'])
        && request.resource.data.householdId is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.targetEmail is string
        && request.resource.data.targetEmail.size() <= 254
        && request.resource.data.targetEmail.matches('^[^\\s@]+@[^\\s@]+[.][^\\s@]+$')
        && request.resource.data.targetEmail == request.resource.data.targetEmail.lower()
        && request.resource.data.targetEmail != request.auth.token.email.lower()
        && request.resource.data.createdAt == request.time
        && request.resource.data.usedBy == null && request.resource.data.usedAt == null
        && get(homePath(request.resource.data.householdId)).data.ownerId == request.auth.uid
        && get(homePath(request.resource.data.householdId)).data.memberIds == [request.auth.uid]
        && request.resource.data.householdName == get(homePath(request.resource.data.householdId)).data.name
        && getAfter(homePath(request.resource.data.householdId)).data.activeInviteId == code;
      allow update: if verified() && recipient(resource.data)
        && usableInvite(resource.data) && activeInvite(code,resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy','usedAt'])
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && consumedWithHome(code,resource.data);
    }
    function taskMember(id) {
      return verified()
        && get(userPath(request.auth.uid)).data.householdId == id
        && request.auth.uid in get(homePath(id)).data.memberIds;
    }
    function taskCalendarDate(value) {
      let parts = value.split('-');
      let year = int(parts[0]);
      let month = int(parts[1]);
      let day = int(parts[2]);
      let date = timestamp.date(year,month,day);
      return date.year() == year && date.month() == month && date.day() == day;
    }
    function validTask(id,data) {
      return data.keys().hasAll(['title','assigneeIds','dueDate','priority','completed','version','createdAt','createdBy','updatedAt','updatedBy'])
        && data.keys().hasOnly(['title','assigneeIds','dueDate','priority','completed','version','createdAt','createdBy','updatedAt','updatedBy'])
        && data.title is string && data.title == data.title.trim()
        && data.title.matches('(?s).{1,100}')
        && data.assigneeIds is list && data.assigneeIds.size() <= 2
        && data.assigneeIds.toSet().size() == data.assigneeIds.size()
        && data.assigneeIds.toSet().hasOnly(get(homePath(id)).data.memberIds)
        && (data.dueDate == null || (data.dueDate is string
          && data.dueDate.matches('^[1-9][0-9]{3}-[0-9]{2}-[0-9]{2}$')
          && taskCalendarDate(data.dueDate)))
        && data.priority in ['low','medium','high']
        && data.completed is bool
        && data.version is int && data.version >= 1 && data.version <= 9007199254740991
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.createdBy is string && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }
    match /households/{householdId}/tasks/{taskId} {
      allow get: if taskMember(householdId);
      allow list: if taskMember(householdId) && request.query.limit is int && request.query.limit > 0;
      allow create: if taskMember(householdId) && validTask(householdId,request.resource.data)
        && request.resource.data.version == 1 && request.resource.data.completed == false
        && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
      allow update: if taskMember(householdId) && validTask(householdId,request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.version == resource.data.version + 1;
      allow delete: if taskMember(householdId);
    }
    function recurringPath(hid,id) { return /databases/$(database)/documents/households/$(hid)/recurringTasks/$(id); }
    function completionPath(hid,id) { return /databases/$(database)/documents/households/$(hid)/recurringCompletions/$(id); }
    function recDate(value) {
      let parts = value.split('-');
      return timestamp.date(int(parts[0]),int(parts[1]),int(parts[2]));
    }
    function recValidDate(value) {
      return value is string && value.matches('^[1-9][0-9]{3}-[0-9]{2}-[0-9]{2}$') && taskCalendarDate(value);
    }
    function recMonth(year,month,day) {
      let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
      let days = month == 2 ? (leap ? 29 : 28) : (month in [4,6,9,11] ? 30 : 31);
      return timestamp.date(year,month,day > days ? days : day);
    }
    function recMonthlyNext(base,anchor) {
      let candidate = recMonth(base.year(),base.month(),anchor.day());
      return candidate > base ? candidate : recMonth(base.month() == 12 ? base.year()+1 : base.year(),base.month() == 12 ? 1 : base.month()+1,anchor.day());
    }
    function recNext(data) {
      let due = recDate(data.nextDueDate);
      let today = (request.time + duration.value(9,'h')).date();
      let base = due > today ? due : today;
      let anchor = recDate(data.startDate);
      let gap = (anchor.dayOfWeek()-base.dayOfWeek()+7) % 7;
      return data.frequency == 'daily' ? base + duration.value(1,'d')
        : (data.frequency == 'weekly' ? base + duration.value(gap == 0 ? 7 : gap,'d') : recMonthlyNext(base,anchor));
    }
    function recCycle(data) {
      let due = recDate(data.nextDueDate);
      let anchor = recDate(data.startDate);
      return due >= anchor && (data.frequency == 'daily'
        || (data.frequency == 'weekly' && due.dayOfWeek() == anchor.dayOfWeek())
        || (data.frequency == 'monthly' && due == recMonth(due.year(),due.month(),anchor.day())));
    }
    function recMeta(data) {
      return {'taskType':data.get('taskType','general'),'place':data.get('place',''),'rotation':data.get('rotation','fixed')};
    }
    function recExtra(hid,data) {
      let fields = ['taskType','place','rotation'];
      let meta = recMeta(data);
      return (!data.keys().hasAny(fields) || data.keys().hasAll(fields))
        && meta.taskType in ['general','cleaning'] && meta.rotation in ['fixed','alternate']
        && meta.place is string && meta.place == meta.place.trim()
        && ((meta.taskType == 'general' && meta.place == '') || (meta.taskType == 'cleaning' && meta.place.matches('[^\\r\\n\\t]{1,40}')))
        && (meta.rotation == 'fixed' || (get(homePath(hid)).data.memberIds.size() == 2 && data.assigneeIds.size() == 1));
    }
    function recCompatible(before,after) {
      return !before.keys().hasAny(['taskType','place','rotation']) || after.keys().hasAll(['taskType','place','rotation']);
    }
    function recSnapshot(before,record) {
      return recMeta(before) == recMeta(record)
        && (!before.keys().hasAny(['taskType','place','rotation']) || record.keys().hasAll(['taskType','place','rotation']))
        && (!record.keys().hasAny(['taskType','place','rotation']) || record.keys().hasAll(['taskType','place','rotation']));
    }
    function recRotated(hid,before,after) {
      return recMeta(before).rotation == 'fixed' ? after.assigneeIds == before.assigneeIds
        : (after.assigneeIds.size() == 1 && after.assigneeIds.toSet() == get(homePath(hid)).data.memberIds.toSet().difference(before.assigneeIds.toSet()));
    }
    function validRecurring(hid,data) {
      return data.keys().hasAll(['title','assigneeIds','priority','frequency','startDate','nextDueDate','active','version','lastCompletionId','lastAction','createdAt','createdBy','updatedAt','updatedBy'])
        && data.keys().hasOnly(['title','assigneeIds','priority','frequency','startDate','nextDueDate','active','version','lastCompletionId','lastAction','createdAt','createdBy','updatedAt','updatedBy','taskType','place','rotation'])
        && recExtra(hid,data)
        && data.title is string && data.title == data.title.trim() && data.title.matches('(?s).{1,100}')
        && data.assigneeIds is list && data.assigneeIds.size() <= 2
        && data.assigneeIds.toSet().size() == data.assigneeIds.size()
        && data.assigneeIds.toSet().hasOnly(get(homePath(hid)).data.memberIds)
        && data.priority in ['low','medium','high'] && data.frequency in ['daily','weekly','monthly']
        && recValidDate(data.startDate) && recValidDate(data.nextDueDate)
        && (!(data.lastAction in ['create','edit']) || recCycle(data))
        && data.active is bool && data.version is int && data.version >= 1 && data.version <= 9007199254740991
        && (data.lastCompletionId == null || (data.lastCompletionId is string && data.lastCompletionId.size() <= 150))
        && data.lastAction in ['create','edit','pause','resume','complete','undo']
        && data.createdAt is timestamp && data.createdBy is string
        && data.updatedAt == request.time && data.updatedBy == request.auth.uid;
    }
    function recCompletion(hid,id,before,after) {
      let recordId = id + '_' + string(after.version);
      let record = getAfter(completionPath(hid,recordId)).data;
      return before.active && after.active && after.lastCompletionId == recordId
        && recRotated(hid,before,after)
        && after.diff(before).affectedKeys().hasOnly(['assigneeIds','nextDueDate','lastCompletionId','lastAction','version','updatedAt','updatedBy'])
        && recDate(after.nextDueDate) == recNext(before)
        && !exists(completionPath(hid,recordId))
        && record.scheduleId == id && record.scheduleVersion == after.version
        && record.scheduledDate == before.nextDueDate && record.nextDueDate == after.nextDueDate
        && record.completedAt == request.time && record.completedBy == request.auth.uid;
    }
    function recUndo(hid,id,before,after) {
      let record = get(completionPath(hid,before.lastCompletionId)).data;
      let changed = getAfter(completionPath(hid,before.lastCompletionId)).data;
      return before.lastCompletionId == id + '_' + string(before.version)
        && record.scheduleId == id && record.scheduleVersion == before.version
        && record.cancelledAt == null && record.cancelledBy == null
        && after.lastCompletionId == null && after.nextDueDate == record.scheduledDate && after.assigneeIds == record.assigneeIds
        && after.diff(before).affectedKeys().hasOnly(['assigneeIds','nextDueDate','lastCompletionId','lastAction','version','updatedAt','updatedBy'])
        && changed.cancelledAt == request.time && changed.cancelledBy == request.auth.uid;
    }
    function recEdit(before,after) {
      return recCompatible(before,after) && after.lastCompletionId == null && (
        (after.lastAction == 'edit' && after.diff(before).affectedKeys().hasOnly(['taskType','place','rotation','title','assigneeIds','priority','frequency','startDate','nextDueDate','lastAction','lastCompletionId','version','updatedAt','updatedBy']))
        || (after.lastAction == 'pause' && before.active && !after.active && after.diff(before).affectedKeys().hasOnly(['active','lastAction','lastCompletionId','version','updatedAt','updatedBy']))
        || (after.lastAction == 'resume' && !before.active && after.active && after.diff(before).affectedKeys().hasOnly(['active','lastAction','lastCompletionId','version','updatedAt','updatedBy']))
      );
    }
    match /households/{hid}/recurringTasks/{id} {
      allow get: if taskMember(hid);
      allow list: if taskMember(hid) && request.query.limit is int && request.query.limit > 0;
      allow create: if taskMember(hid) && id.size() <= 100 && validRecurring(hid,request.resource.data)
        && request.resource.data.version == 1 && request.resource.data.active
        && request.resource.data.lastAction == 'create' && request.resource.data.lastCompletionId == null
        && request.resource.data.startDate == request.resource.data.nextDueDate
        && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
      allow update: if taskMember(hid) && validRecurring(hid,request.resource.data)
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy
        && ((request.resource.data.lastAction == 'complete' && recCompletion(hid,id,resource.data,request.resource.data))
          || (request.resource.data.lastAction == 'undo' && resource.data.lastCompletionId is string && recUndo(hid,id,resource.data,request.resource.data))
          || recEdit(resource.data,request.resource.data));
      allow delete: if false;
    }
    function validCompletion(hid,id,data) {
      let before = get(recurringPath(hid,data.scheduleId)).data;
      let after = getAfter(recurringPath(hid,data.scheduleId)).data;
      return data.keys().hasAll(['scheduleId','scheduleVersion','title','assigneeIds','priority','frequency','startDate','scheduledDate','nextDueDate','completedAt','completedBy','cancelledAt','cancelledBy'])
        && data.keys().hasOnly(['scheduleId','scheduleVersion','title','assigneeIds','priority','frequency','startDate','scheduledDate','nextDueDate','completedAt','completedBy','cancelledAt','cancelledBy','taskType','place','rotation'])
        && recSnapshot(before,data)
        && data.scheduleId is string && id == data.scheduleId + '_' + string(after.version)
        && before.active && after.version == before.version + 1 && data.scheduleVersion == after.version
        && after.lastAction == 'complete' && after.lastCompletionId == id
        && data.title == before.title && data.assigneeIds == before.assigneeIds && data.priority == before.priority
        && data.frequency == before.frequency && data.startDate == before.startDate
        && data.scheduledDate == before.nextDueDate && data.nextDueDate == after.nextDueDate
        && data.completedAt == request.time && data.completedBy == request.auth.uid
        && data.cancelledAt == null && data.cancelledBy == null;
    }
    function cancelCompletion(hid,id,before,after) {
      let schedule = get(recurringPath(hid,before.scheduleId)).data;
      let changed = getAfter(recurringPath(hid,before.scheduleId)).data;
      return before.cancelledAt == null && before.cancelledBy == null
        && after.diff(before).affectedKeys().hasOnly(['cancelledAt','cancelledBy'])
        && after.cancelledAt == request.time && after.cancelledBy == request.auth.uid
        && schedule.lastCompletionId == id && schedule.version == before.scheduleVersion
        && changed.version == schedule.version + 1 && changed.lastCompletionId == null
        && changed.lastAction == 'undo' && changed.nextDueDate == before.scheduledDate;
    }
    match /households/{hid}/recurringCompletions/{id} {
      allow get: if taskMember(hid);
      allow list: if taskMember(hid) && request.query.limit is int && request.query.limit > 0;
      allow create: if taskMember(hid) && validCompletion(hid,id,request.resource.data);
      allow update: if taskMember(hid) && cancelCompletion(hid,id,resource.data,request.resource.data);
      allow delete: if false;
    }
    function validShopping(hid,data) {
      return data.keys().hasAll(['title','category','quantity','unit','budget','assigneeIds','priority','purchased','version','createdAt','createdBy','updatedAt','updatedBy'])
        && data.keys().hasOnly(['title','category','quantity','unit','budget','assigneeIds','priority','purchased','version','createdAt','createdBy','updatedAt','updatedBy'])
        && data.title is string && data.title == data.title.trim() && data.title.matches('(?s).{1,100}')
        && data.category in ['food','daily','furniture','appliances','other']
        && data.quantity is string && data.quantity != '0' && data.quantity.matches('^(0|[1-9][0-9]{0,5})([.][0-9]{0,2}[1-9])?$')
        && data.unit is string && data.unit == data.unit.trim() && data.unit.matches('(?s).{0,10}')
        && (data.budget == null || (data.budget is int && data.budget >= 0 && data.budget <= 999999999))
        && data.assigneeIds is list && data.assigneeIds.size() <= 2 && data.assigneeIds.toSet().size() == data.assigneeIds.size()
        && data.assigneeIds.toSet().hasOnly(get(homePath(hid)).data.memberIds)
        && data.priority is int && data.priority in [1,2,3] && data.purchased is bool
        && data.version is int && data.version >= 1 && data.version <= 9007199254740991
        && data.createdAt is timestamp && data.createdBy is string
        && data.updatedAt == request.time && data.updatedBy == request.auth.uid;
    }
    match /households/{hid}/shoppingItems/{id} {
      allow get: if taskMember(hid);
      allow list: if taskMember(hid) && request.query.limit is int && request.query.limit > 0;
      allow create: if taskMember(hid) && validShopping(hid,request.resource.data)
        && request.resource.data.version == 1 && !request.resource.data.purchased
        && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
      allow update: if taskMember(hid) && validShopping(hid,request.resource.data)
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if taskMember(hid);
    }
    function validDeclutter(hid, data) {
      return data.keys().hasAll(['title','method','ownerIds','dueDate','sortDueDate','completed','completedAt','completedBy','version','createdAt','createdBy','updatedAt','updatedBy'])
        && data.keys().hasOnly(['title','method','ownerIds','dueDate','sortDueDate','completed','completedAt','completedBy','version','createdAt','createdBy','updatedAt','updatedBy'])
        && data.title is string && data.title == data.title.trim() && data.title.matches('(?s).{1,100}')
        && data.method in ['discard','sell','give','hold']
        && data.ownerIds is list && data.ownerIds.size() <= 2 && data.ownerIds.toSet().size() == data.ownerIds.size()
        && data.ownerIds.toSet().hasOnly(get(homePath(hid)).data.memberIds)
        && (data.dueDate == null || recValidDate(data.dueDate))
        && data.sortDueDate == (data.dueDate == null ? '~' : data.dueDate)
        && data.completed is bool
        && (data.completed
          ? (data.method != 'hold' && data.completedAt is timestamp && data.completedBy in get(homePath(hid)).data.memberIds)
          : (data.completedAt == null && data.completedBy == null))
        && data.version is int && data.version >= 1 && data.version <= 9007199254740991
        && data.createdAt is timestamp && data.createdBy is string
        && data.updatedAt == request.time && data.updatedBy == request.auth.uid;
    }
    function declutterCompletion(before, after) {
      return !after.completed || (before.completed
        ? (after.completedAt == before.completedAt && after.completedBy == before.completedBy)
        : (after.completedAt == request.time && after.completedBy == request.auth.uid));
    }
    match /households/{hid}/declutterItems/{id} {
      allow get: if taskMember(hid);
      allow list: if taskMember(hid) && request.query.limit is int && request.query.limit > 0;
      allow create: if taskMember(hid) && validDeclutter(hid,request.resource.data)
        && request.resource.data.version == 1 && !request.resource.data.completed
        && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
      allow update: if taskMember(hid) && validDeclutter(hid,request.resource.data)
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy
        && declutterCompletion(resource.data,request.resource.data);
      allow delete: if taskMember(hid);
    }
    function financeCategoryPath(hid,id) {
      return /databases/$(database)/documents/households/$(hid)/financeCategories/$(id);
    }
    function financeStandardId(id) {
      return id in ['income_salary','income_bonus','income_other','expense_food','expense_daily','expense_housing','expense_utilities','expense_communication','expense_transport','expense_furniture','expense_medical','expense_entertainment','expense_other'];
    }
    function validFinanceCategory(hid,id,data) {
      return data.keys().hasAll(['type','name','archived','standard','version','createdAt','createdBy','updatedAt','updatedBy'])
        && data.keys().hasOnly(['type','name','archived','standard','version','createdAt','createdBy','updatedAt','updatedBy'])
        && data.type in ['income','expense']
        && data.name is string && data.name == data.name.trim() && data.name.matches('(?s).{1,40}')
        && data.archived is bool && data.standard is bool
        && (data.standard ? financeStandardId(id) : !financeStandardId(id))
        && data.version is int && data.version >= 1 && data.version <= 9007199254740991
        && data.createdAt is timestamp && data.createdBy is string
        && data.updatedAt == request.time && data.updatedBy == request.auth.uid
        && (data.standard ? (
          (id == 'income_salary' && data.type == 'income') || (id == 'income_bonus' && data.type == 'income') || (id == 'income_other' && data.type == 'income')
          || (id == 'expense_food' && data.type == 'expense') || (id == 'expense_daily' && data.type == 'expense') || (id == 'expense_housing' && data.type == 'expense')
          || (id == 'expense_utilities' && data.type == 'expense') || (id == 'expense_communication' && data.type == 'expense') || (id == 'expense_transport' && data.type == 'expense')
          || (id == 'expense_furniture' && data.type == 'expense') || (id == 'expense_medical' && data.type == 'expense') || (id == 'expense_entertainment' && data.type == 'expense') || (id == 'expense_other' && data.type == 'expense')
        ) : true);
    }
    function initialFinanceCategoryName(id,data) {
      return (id == 'income_salary' && data.name == '給与') || (id == 'income_bonus' && data.name == '賞与') || (id == 'income_other' && data.name == 'その他' && data.type == 'income')
        || (id == 'expense_food' && data.name == '食費') || (id == 'expense_daily' && data.name == '日用品') || (id == 'expense_housing' && data.name == '住居費')
        || (id == 'expense_utilities' && data.name == '水道光熱費') || (id == 'expense_communication' && data.name == '通信費') || (id == 'expense_transport' && data.name == '交通費')
        || (id == 'expense_furniture' && data.name == '家具家電') || (id == 'expense_medical' && data.name == '医療') || (id == 'expense_entertainment' && data.name == '娯楽') || (id == 'expense_other' && data.name == 'その他' && data.type == 'expense');
    }
    function validFinanceEntry(hid,data,allowArchived,oldCategoryId) {
      let category = get(financeCategoryPath(hid,data.categoryId)).data;
      return data.keys().hasAll(['type','title','amount','date','categoryId','memo','version','createdAt','createdBy','updatedAt','updatedBy'])
        && data.keys().hasOnly(['type','title','amount','date','categoryId','memo','version','createdAt','createdBy','updatedAt','updatedBy','sharing'])
        && validSharing(hid,data)
        && data.type in ['income','expense']
        && data.title is string && data.title == data.title.trim() && data.title.matches('(?s).{1,100}')
        && data.amount is int && data.amount >= 1 && data.amount <= 999999999
        && recValidDate(data.date)
        && data.categoryId is string && exists(financeCategoryPath(hid,data.categoryId))
        && category.type == data.type && (!category.archived || (allowArchived && data.categoryId == oldCategoryId))
        && data.memo is string && data.memo == data.memo.trim() && data.memo.matches('(?s).{0,500}')
        && data.version is int && data.version >= 1 && data.version <= 9007199254740991
        && data.createdAt is timestamp && data.createdBy is string
        && data.updatedAt == request.time && data.updatedBy == request.auth.uid;
    }
    match /households/{hid}/financeCategories/{id} {
      allow get: if taskMember(hid);
      allow list: if taskMember(hid) && request.query.limit is int && request.query.limit > 0 && request.query.limit <= 100;
      allow create: if taskMember(hid) && validFinanceCategory(hid,id,request.resource.data)
        && request.resource.data.version == 1 && !request.resource.data.archived
        && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid
        && (!request.resource.data.standard || initialFinanceCategoryName(id,request.resource.data));
      allow update: if taskMember(hid) && validFinanceCategory(hid,id,request.resource.data)
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.type == resource.data.type && request.resource.data.standard == resource.data.standard
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','archived','version','updatedAt','updatedBy']);
      allow delete: if false;
    }
    match /households/{hid}/incomes/{id} {
      allow get: if taskMember(hid);
      allow list: if taskMember(hid) && request.query.limit is int && request.query.limit > 0 && request.query.limit <= 10000;
      allow create: if taskMember(hid) && validFinanceEntry(hid,request.resource.data,false,null) && request.resource.data.type == 'income'
        && request.resource.data.version == 1 && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
      allow update: if taskMember(hid) && validFinanceEntry(hid,request.resource.data,true,resource.data.categoryId) && request.resource.data.type == 'income'
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if taskMember(hid);
    }
    match /households/{hid}/expenses/{id} {
      allow get: if taskMember(hid);
      allow list: if taskMember(hid) && request.query.limit is int && request.query.limit > 0 && request.query.limit <= 10000;
      allow create: if taskMember(hid) && validFinanceEntry(hid,request.resource.data,false,null) && request.resource.data.type == 'expense'
        && expenseGuards(hid,id,{},request.resource.data)
        && request.resource.data.version == 1 && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
      allow update: if taskMember(hid) && validFinanceEntry(hid,request.resource.data,true,resource.data.categoryId) && request.resource.data.type == 'expense'
        && (!resource.data.keys().hasAny(['sharing']) || request.resource.data.keys().hasAll(['sharing']))
        && expenseGuards(hid,id,resource.data,request.resource.data)
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if taskMember(hid) && expenseGuards(hid,id,resource.data,{});
    }
    function validBudgetMonth(month) {
      return month is string && month.matches('^[1-9][0-9]{3}-(0[1-9]|1[0-2])$');
    }
    function validBudget(hid,id,data) {
      return data.keys().hasAll(['month','scope','categoryId','amount','version','createdAt','createdBy','updatedAt','updatedBy'])
        && data.keys().hasOnly(['month','scope','categoryId','amount','version','createdAt','createdBy','updatedAt','updatedBy'])
        && validBudgetMonth(data.month)
        && ((data.scope == 'total' && data.categoryId == null && id == data.month + '__total')
          || (data.scope == 'category' && data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 128
            && id == data.month + '__category__' + data.categoryId
            && get(financeCategoryPath(hid,data.categoryId)).data.type == 'expense'
            && get(financeCategoryPath(hid,data.categoryId)).data.archived == false))
        && data.amount is int && data.amount >= 0 && data.amount <= 999999999
        && data.version is int && data.version >= 1 && data.version <= 9007199254740991
        && data.createdAt is timestamp && data.createdBy is string
        && data.updatedAt == request.time && data.updatedBy == request.auth.uid;
    }
    match /households/{hid}/budgets/{id} {
      allow get: if taskMember(hid);
      allow list: if taskMember(hid) && request.query.limit is int && request.query.limit > 0 && request.query.limit <= 102;
      allow create: if taskMember(hid) && validBudget(hid,id,request.resource.data)
        && request.resource.data.version == 1 && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
      allow update: if taskMember(hid) && validBudget(hid,id,request.resource.data)
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.month == resource.data.month && request.resource.data.scope == resource.data.scope && request.resource.data.categoryId == resource.data.categoryId;
      allow delete: if taskMember(hid);
    }
    function validSharing(hid,data) {
      let s = data.get('sharing',null);
      let members = get(/databases/$(database)/documents/households/$(hid)).data.memberIds;
      return data.type == 'income' ? !data.keys().hasAny(['sharing'])
        : s == null || (s is map && s.keys().hasAll(['payerId','shares']) && s.keys().hasOnly(['payerId','shares'])
          && members.size() == 2 && s.payerId in members && s.shares is map
          && s.shares.keys().hasAll(members) && s.shares.keys().hasOnly(members)
          && s.shares[members[0]] is int && s.shares[members[1]] is int
          && s.shares[members[0]] >= 0 && s.shares[members[0]] <= 100
          && s.shares[members[1]] >= 0 && s.shares[members[1]] <= 100
          && s.shares[members[0]] + s.shares[members[1]] == 100);
    }
    function settlementMonthPath(hid,month) {
      return /databases/$(database)/documents/households/$(hid)/settlementMonths/$(month);
    }
    function settlementPaymentPath(hid,id) {
      return /databases/$(database)/documents/households/$(hid)/settlementPayments/$(id);
    }
    function settlementExpensePath(hid,id) {
      return /databases/$(database)/documents/households/$(hid)/expenses/$(id);
    }
    function expenseHasMonth(data,month) {
      return data != null && data.get('sharing',null) != null && data.date[0:7] == month;
    }
    function expenseMonthGuard(hid,id,data) {
      let month = data.date[0:7];
      let path = settlementMonthPath(hid,month);
      let after = getAfter(path).data;
      return after.version == (exists(path) ? get(path).data.version + 1 : 1)
        && after.lastKind == 'expense' && after.lastId == id;
    }
    function expenseGuards(hid,id,before,after) {
      return (before == null || before.get('sharing',null) == null || expenseMonthGuard(hid,id,before))
        && (after == null || after.get('sharing',null) == null || expenseMonthGuard(hid,id,after));
    }
    function monthExpenseChange(hid,month,data) {
      let path = settlementExpensePath(hid,data.lastId);
      let before = exists(path) ? get(path).data : {};
      let after = existsAfter(path) ? getAfter(path).data : {};
      return (expenseHasMonth(before,month) || expenseHasMonth(after,month)) && before != after
        && data.netPaid == (exists(settlementMonthPath(hid,month)) ? get(settlementMonthPath(hid,month)).data.netPaid : 0);
    }
    function validSettlementPayment(hid,data) {
      let members = get(/databases/$(database)/documents/households/$(hid)).data.memberIds;
      return data.keys().hasAll(['month','fromUid','toUid','amount','date','canceledAt','canceledBy','version','createdAt','createdBy','updatedAt','updatedBy'])
        && data.keys().hasOnly(['month','fromUid','toUid','amount','date','canceledAt','canceledBy','version','createdAt','createdBy','updatedAt','updatedBy'])
        && validBudgetMonth(data.month) && recValidDate(data.date)
        && members.size() == 2 && data.fromUid in members && data.toUid in members && data.fromUid != data.toUid
        && data.amount is int && data.amount >= 1 && data.amount <= 9999999999999
        && data.version is int && data.version >= 1 && data.version <= 9007199254740991
        && data.createdAt is timestamp && data.createdBy is string
        && data.updatedAt == request.time && data.updatedBy == request.auth.uid;
    }
    function paymentMonthGuard(hid,id,data,kind) {
      let path = settlementMonthPath(hid,data.month);
      let after = getAfter(path).data;
      return after.version == (exists(path) ? get(path).data.version+1 : 1) && after.lastKind == kind && after.lastId == id;
    }
    function monthPaymentChange(hid,month,data) {
      let path = settlementPaymentPath(hid,data.lastId);
      let after = getAfter(path).data;
      let delta = after.toUid == get(/databases/$(database)/documents/households/$(hid)).data.ownerId ? after.amount : -after.amount;
      let previous = exists(settlementMonthPath(hid,month)) ? get(settlementMonthPath(hid,month)).data.netPaid : 0;
      return after.month == month && (data.lastKind == 'payment'
        ? !exists(path) && after.canceledAt == null && data.netPaid == previous + delta
        : exists(path) && get(path).data.canceledAt == null && after.canceledAt == request.time && data.netPaid == previous - delta);
    }
    function validSettlementMonth(hid,id,data) {
      return data.keys().hasAll(['month','netPaid','version','lastKind','lastId','createdAt','createdBy','updatedAt','updatedBy'])
        && data.keys().hasOnly(['month','netPaid','version','lastKind','lastId','createdAt','createdBy','updatedAt','updatedBy'])
        && validBudgetMonth(id) && data.month == id
        && data.netPaid is int && data.netPaid >= -999999999999999 && data.netPaid <= 999999999999999
        && data.version is int && data.version >= 1 && data.version <= 9007199254740991
        && data.lastId is string && data.lastId.size() > 0 && data.lastId.size() <= 128
        && data.createdAt is timestamp && data.createdBy is string
        && data.updatedAt == request.time && data.updatedBy == request.auth.uid
        && (data.lastKind == 'expense' ? monthExpenseChange(hid,id,data)
          : data.lastKind in ['payment','cancel'] && monthPaymentChange(hid,id,data));
    }
    match /households/{hid}/settlementMonths/{id} {
      allow get: if taskMember(hid);
      allow list: if taskMember(hid) && request.query.limit is int && request.query.limit > 0 && request.query.limit <= 10000;
      allow create: if taskMember(hid) && validSettlementMonth(hid,id,request.resource.data)
        && request.resource.data.version == 1 && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
      allow update: if taskMember(hid) && validSettlementMonth(hid,id,request.resource.data)
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }
    match /households/{hid}/settlementPayments/{id} {
      allow get: if taskMember(hid);
      allow list: if taskMember(hid) && request.query.limit is int && request.query.limit > 0 && request.query.limit <= 10000;
      allow create: if taskMember(hid) && validSettlementPayment(hid,request.resource.data)
        && request.resource.data.version == 1 && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.canceledAt == null && request.resource.data.canceledBy == null
        && paymentMonthGuard(hid,id,request.resource.data,'payment');
      allow update: if taskMember(hid) && validSettlementPayment(hid,request.resource.data)
        && resource.data.canceledAt == null && request.resource.data.canceledAt == request.time && request.resource.data.canceledBy == request.auth.uid
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['canceledAt','canceledBy','version','updatedAt','updatedBy'])
        && paymentMonthGuard(hid,id,request.resource.data,'cancel');
      allow delete: if false;
    }
    // 未実装の業務データは引き続き全拒否。
    match /{document=**} { allow read, write: if false; }
  }
}
